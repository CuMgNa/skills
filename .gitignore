# Dependencies (npm)
node_modules/
**/node_modules/

# QA pipeline runtime output (runtime state, do not commit)
output/runtime/handoff/latest.json
output/runtime/handoff/*.json
output/runtime/handoff/*.mjs
output/runtime/handoff/regression/
!output/runtime/handoff/.gitkeep
# 注：handoff.schema.json 实测不存在，已删除其保留规则
output/runtime/reports/
output/runtime/snapshots/
output/runtime/bug-semantic/
output/runtime/report-debug/
output/runtime/_zt_projects.json
output/runtime/_PENDING_MOVE.txt

# Canvas runtime state (user interactions, not source)
**/*.canvas.data.json
**/*.canvas.status.json

# Playwright MCP logs and page dumps
.playwright-mcp/

# Secrets and local config
.env
.mcp.json

# One-off output scripts (may contain API tokens)
output/runtime/notion-*.py
output/runtime/dingtalk_push_*.py
output/runtime/*_push_*.py

# Python bytecode cache (auto-generated, not source)
__pycache__/
*.pyc
*.pyo
services/**/__pycache__/

# Word temporary lock files
~$*
